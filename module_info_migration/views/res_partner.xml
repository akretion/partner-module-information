<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_form_view" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="module_auth_api_key_id" position="after">
                <field name="target_odoo_version_id" />
                <field name="id" invisible="True" />
                <field name="migration_project_id" />
            </field>
        </field>
    </record>

    <record id="view_module_partner_kanban" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="module_info_partner.view_module_partner_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_128']" position="after">
                <field name="migrated_module_nbr" />
                <field name="target_odoo_version_id" />
            </xpath>

            <xpath expr="//div[@id='project_box']" position="inside">
                <div invisible="not target_odoo_version_id">
                    <a name="get_action_migration_tree" type="object">
                        <span>Migration
                            <t t-esc="record.target_odoo_version_id.value" />:
                            <t t-esc="record.migrated_module_nbr.value" /> /
                            <t t-esc="record.module_nbr.value" />
                        </span>
                    </a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
