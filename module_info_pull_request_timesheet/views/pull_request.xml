<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pull_request_form_view" model="ir.ui.view">
        <field name="name">pull.request.form.view</field>
        <field name="model">pull.request</field>
        <field
            name="inherit_id"
            ref="module_info_pull_request_task_link.pull_request_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='project']" position="after">
                <group string="Timesheet" invisible="not timesheet_ids and not task_id">
                    <field
                        colspan="2"
                        name="timesheet_ids"
                        mode="list,kanban"
                        nolabel="1"
                    >
                        <list editable="bottom" default_order="date">
                            <field name="date" />
                            <field name="user_id" invisible="1" />
                            <field
                                name="employee_id"
                                required="1"
                                widget="many2one_avatar_employee"
                                context="{'active_test': True}"
                            />
                            <field name="name" required="0" />
                            <field
                                name="unit_amount"
                                widget="timesheet_uom"
                                decoration-danger="unit_amount &gt; 24"
                            />
                            <field name="project_id" invisible="1" />
                            <field name="task_id" invisible="1" />
                            <field name="company_id" invisible="1" />
                        </list>
                        <form string="Timesheet Activities">
                            <sheet>
                                <group>
                                    <field name="date" />
                                    <field name="user_id" invisible="1" />
                                    <field
                                        name="employee_id"
                                        required="1"
                                        widget="many2one_avatar_employee"
                                        context="{'active_test': True}"
                                    />
                                    <field name="name" required="0" />
                                    <field
                                        name="unit_amount"
                                        string="Duration"
                                        widget="float_time"
                                        decoration-danger="unit_amount &gt; 24"
                                    />
                                    <field name="project_id" invisible="1" />
                                    <field name="task_id" invisible="1" />
                                    <field name="company_id" invisible="1" />
                                </group>
                            </sheet>
                        </form>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
